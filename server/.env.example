# ============================================================
# NextStep Server — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.
# ============================================================

# MongoDB connection URI
# Local:  mongodb://localhost:27017/nextstep
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/nextstep
MONGO_URI=mongodb://localhost:27017/nextstep

# JWT Secret — MUST be at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-secure-random-string-at-least-32-chars

# Server environment: development | production | test
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# Exact frontend origin (no trailing slash).
# In production: https://your-nextstep-app.vercel.app
ALLOWED_ORIGIN=http://localhost:5173
